# Besec Tracking PWA - Environment Configuration
# Copy this file to .env.local for development or .env.production for production

# =============================================================================
# API Configuration
# =============================================================================

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=https://besecridetracking.azurewebsites.net

# =============================================================================
# Google Maps Configuration
# =============================================================================

# Google Maps API Key - Get from https://console.cloud.google.com
# Required APIs: Maps JavaScript API, Geocoding API, Roads API (snap-to-road)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# =============================================================================
# Push Notifications (Optional)
# =============================================================================

# Notification API URL (Azure Functions endpoint)
# If not set, defaults to VITE_API_BASE_URL
VITE_NOTIFICATION_API_URL=https://your-functions-app.azurewebsites.net

# VAPID Public Key for Web Push Notifications
# Generate using: npx web-push generate-vapid-keys
# Must match the key configured in Azure Functions
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# =============================================================================
# Feature Flags
# =============================================================================

# Enable debug logging in console (true/false)
VITE_ENABLE_DEBUG_LOGGING=false

# Enable mock API for testing without backend (true/false)
VITE_ENABLE_MOCK_API=false
